---
/**
 * The install map. State outlines are pre-projected (Albers, US standard parallels) in
 * src/data/us-map.json; cities come from site.json as lat/lon and are projected here with
 * the same parameters, so adding a city is one line of JSON.
 */
import map from '../data/us-map.json';
import { site } from '../lib/site';

type City = { name: string; state: string; lat: number; lon: number; base?: boolean };
const cities = site.cities as City[];

const rad = (d: number) => (d * Math.PI) / 180;
const { lat0, lon0, lat1, lat2 } = map.albers;
const n = (Math.sin(rad(lat1)) + Math.sin(rad(lat2))) / 2;
const C = Math.cos(rad(lat1)) ** 2 + 2 * n * Math.sin(rad(lat1));
const r0 = Math.sqrt(C - 2 * n * Math.sin(rad(lat0))) / n;
function project(lon: number, lat: number) {
  const r = Math.sqrt(C - 2 * n * Math.sin(rad(lat))) / n;
  const t = n * (rad(lon) - rad(lon0));
  const x = r * Math.sin(t), y = r0 - r * Math.cos(t);
  const { minx, maxy, scale, pad } = map.fit;
  return { x: (x - minx) * scale + pad, y: (maxy - y) * scale + pad };
}
const pins = cities.map((c) => ({ ...c, ...project(c.lon, c.lat) }));
const [W, H] = map.viewBox;
const bases = pins.filter((p) => p.base).length;
const installs = pins.length - bases;
---
<figure class="map">
  <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-label={`Map of the United States showing ${cities.map((c) => c.name).join(' and ')}`}>
    <path class="states" d={map.paths}></path>
    {pins.map((p) => (
      <g class:list={['pin', { base: p.base }]} tabindex="0" transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
        {p.base && <circle class="ring" r="11"></circle>}
        <circle class="dot" r={p.base ? 5 : 3.2}></circle>
        <text class="label" x={p.name === 'New York' ? 12 : 12} y={p.name === 'Philadelphia' ? 18 : -8}>{p.name}, {p.state}</text>
      </g>
    ))}
  </svg>
  <figcaption class="mono">
    <span><i class="sw base"></i> Base{bases === 1 ? '' : 's'} · Philadelphia &amp; New York</span>
    <span><i class="sw"></i> {installs ? `${installs} install cities` : 'Install cities added as jobs complete'}</span>
  </figcaption>
</figure>

<style>
  .map { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  svg { display: block; overflow: visible; }
  .states { fill: var(--stock); stroke: rgba(32, 28, 27, 0.22); stroke-width: 0.8; stroke-linejoin: round; }
  .pin { cursor: default; outline: none; }
  .dot { fill: var(--ink); }
  .base .dot { fill: var(--red); }
  .ring { fill: none; stroke: var(--red); stroke-width: 1; opacity: 0.55; transform-box: fill-box; transform-origin: center; animation: pulse 2.8s ease-out infinite; }
  .label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.04em; fill: var(--ink); paint-order: stroke; stroke: var(--paper); stroke-width: 3px; stroke-linejoin: round; opacity: 0; transition: opacity 0.15s; }
  .base .label { opacity: 1; }
  .pin:hover .label, .pin:focus-visible .label { opacity: 1; }
  .pin:hover .dot, .pin:focus-visible .dot { fill: var(--red); }
  figcaption { display: flex; gap: 24px; flex-wrap: wrap; font-size: 11px; letter-spacing: 0.04em; color: var(--muted); }
  .sw { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--ink); margin-right: 8px; vertical-align: middle; }
  .sw.base { background: var(--red); }
  @media (max-width: 680px) { .label { display: none; } }
  @keyframes pulse { 0% { transform: scale(0.45); opacity: 0.7; } 100% { transform: scale(1.6); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .ring { animation: none; opacity: 0.35; } }
</style>
