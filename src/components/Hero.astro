---
import Photo from './Photo.astro';
import CropMarks from './CropMarks.astro';
import { site, url } from '../lib/site';
import hero from '../assets/hero.jpg';
---
<section class="hero">
  <Photo src={hero} alt="Large-format exterior banner installed on the stadium façade at Citizens Bank Park, Philadelphia" class="bg" sizes="100vw" loading="eager" />
  <div class="card">
    <CropMarks />
    <p class="k k-red">Print production · Philadelphia &amp; New York · Nationwide</p>
    <h1 class="display">{site.tagline}</h1>
    <p class="lede">Design, fabrication, freight and install, handled by one producer, in one location or fifty.</p>
    <div class="actions">
      <a class="btn btn-red" href={url('/start/')}>Start a project</a>
      <a class="btn btn-outline" href={url('/start/#talk')}>Talk to a producer</a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: clamp(560px, 54vw, 780px); display: flex; align-items: flex-end; }
  /* The photo starts to the right of the card and the card overlaps its edge, so the billboard and the stadium sign both stay whole. */
  .hero :global(.bg) { position: absolute; top: 0; bottom: 0; left: 36%; right: 0; }
  .hero :global(.bg img) { object-position: 52% 50%; }
  .hero :global(.bg .cap) { left: auto; right: 24px; top: 20px; bottom: auto; text-align: right; max-width: 40%; }
  .card { position: relative; margin: 0 0 48px 48px; width: clamp(420px, 42vw, 600px); background: var(--paper); padding: 48px 52px 44px; display: flex; flex-direction: column; gap: 22px; }
  h1 { font-size: clamp(36px, 3.9vw, 56px); line-height: 1.04; letter-spacing: -0.01em; }
  .lede { max-width: 32em; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 4px; }
  @media (max-width: 680px) {
    .hero { min-height: 0; flex-direction: column; align-items: stretch; }
    .hero :global(.bg) { position: relative; left: auto; height: 62vw; min-height: 240px; }
    .hero :global(.bg img) { width: 100%; object-position: 50% 30%; }
    .hero :global(.bg .cap) { right: 16px; top: 14px; max-width: 70%; }
    .card { margin: -32px var(--pad) 0; width: auto; padding: 32px 26px 30px; }
    h1 { font-size: 34px; }
  }
</style>
