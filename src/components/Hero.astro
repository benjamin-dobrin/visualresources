---
import Photo from './Photo.astro';
import CropMarks from './CropMarks.astro';
import { site, url } from '../lib/site';
---
<section class="hero">
  <Photo src={site.hero_image} alt={site.hero_alt} tone="warm" label="PHOTO — full-bleed hero" class="bg" sizes="100vw" loading="eager" />
  <div class="card">
    <CropMarks />
    <p class="k k-red">Print production · Philadelphia &amp; New York · Nationwide</p>
    <h1 class="display">{site.tagline}</h1>
    <p class="lede">Design, fabrication, freight and install, handled by one producer, in one location or fifty.</p>
    <div class="actions">
      <a class="btn btn-red" href={url('/start/')}>Start a project</a>
      <a class="btn btn-outline" href={url('/start/#talk')}>Talk to a producer</a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: clamp(560px, 54vw, 780px); display: flex; align-items: flex-end; }
  .hero :global(.bg) { position: absolute; inset: 0; }
  .hero :global(.bg img) { object-position: 50% 30%; }
  .hero :global(.bg .cap) { left: auto; right: 24px; top: 20px; bottom: auto; text-align: right; max-width: 40%; }
  .card { position: relative; margin: 0 0 48px 48px; width: min(720px, calc(100% - 96px)); background: var(--paper); padding: 48px 52px 44px; display: flex; flex-direction: column; gap: 22px; }
  h1 { font-size: clamp(38px, 4.3vw, 62px); line-height: 1.02; letter-spacing: -0.01em; }
  .lede { max-width: 32em; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 4px; }
  /* On a phone the photo runs tall and the card is pulled up over its lower edge, so the
     card-over-photograph composition survives instead of becoming two stacked blocks. */
  @media (max-width: 680px) {
    .hero { min-height: 0; flex-direction: column; align-items: stretch; }
    .hero :global(.bg) { position: relative; height: min(104vw, 520px); min-height: 300px; }
    .hero :global(.bg img) { object-position: 46% 26%; }
    .hero :global(.bg .cap) { right: 16px; top: 14px; max-width: 70%; }
    .card { margin: -132px var(--pad) 0; width: auto; padding: 30px 24px 28px; gap: 18px; }
    .card .k { font-size: 11px; letter-spacing: 0.12em; }
    h1 { font-size: 33px; }
    .lede { font-size: 16px; }
  }
  /* Narrow phones: two full-width buttons read better than two ragged stacked ones. */
  @media (max-width: 420px) {
    .actions { display: grid; grid-template-columns: 1fr; gap: 10px; }
    .actions .btn { text-align: center; }
  }
</style>
