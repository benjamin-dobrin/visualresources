---
import { site, url } from '../lib/site';
import CmykDots from './CmykDots.astro';
---
<footer class="wrap">
  <div class="brand">
    <img src={url('/images/logo.svg')} alt="Visual Resources" width="119" height="44" />
    <span class="mono line">Philadelphia · New York · Nationwide by design</span>
    <CmykDots />
  </div>
  <div class="cols">
    <ul>
      <li><a href={url('/work/')}>Work</a></li>
      <li><a href={url('/rollouts/')}>Rollouts</a></li>
      <li><a href={url('/about/')}>About</a></li>
      <li><a href={url('/start/')}>Start a project</a></li>
    </ul>
    <ul class="mono contact">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      {site.phones.map((p) => (
        <li>{p.tel ? <a href={`tel:${p.tel}`}>{p.display}</a> : <span>{p.display}</span>}</li>
      ))}
    </ul>
  </div>
</footer>

<style>
  footer { padding-top: 56px; padding-bottom: 64px; display: flex; justify-content: space-between; align-items: flex-start; gap: 40px; flex-wrap: wrap; border-top: 1px solid var(--rule); }
  .brand { display: flex; flex-direction: column; gap: 16px; }
  .brand img { height: 30px; width: auto; }
  .line { font-size: 12px; color: var(--muted); letter-spacing: 0.04em; }
  .cols { display: flex; gap: 56px; font-size: 14px; color: var(--body); flex-wrap: wrap; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .contact { font-size: 12.5px; }
</style>
