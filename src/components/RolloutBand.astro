---
import UsMap from './UsMap.astro';
import { site, url } from '../lib/site';
interface Props { link?: boolean }
const { link = true } = Astro.props;
---
<section class="rollout wrap">
  <div class="copy">
    <p class="k k-red">Rollouts &amp; national installation</p>
    <h2 class="display">Forty locations should feel like one project.</h2>
    <p class="lede">One producer, one schedule, one set of approved proofs. Regional fabrication keeps freight short and install windows honest. Completion photos from every site before you see an invoice.</p>
    <div class="stats">
      {site.stats.map((s, i) => (
        <div class:list={{ first: i === 0 }}><span class="display val">{s.value}</span><span class="k">{s.label}</span></div>
      ))}
    </div>
    {link && <a class="link-rule" href={url('/rollouts/')}>How a rollout runs</a>}
  </div>
  <div class="mapwrap"><UsMap /></div>
</section>

<style>
  .rollout { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding-top: var(--section); padding-bottom: var(--section); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 32px; align-items: center; }
  .copy { grid-column: span 6; display: flex; flex-direction: column; gap: 24px; }
  h2 { font-size: clamp(36px, 4vw, 58px); line-height: 1.04; letter-spacing: -0.01em; }
  .lede { max-width: 30em; }
  .stats { display: flex; gap: 48px; margin-top: 8px; flex-wrap: wrap; }
  .stats div { display: flex; flex-direction: column; gap: 6px; border-top: 1.5px solid var(--ink); padding-top: 12px; }
  .stats .first { border-top-color: var(--red); }
  .val { font-size: 48px; line-height: 1; }
  .stats .k { font-size: 11px; }
  .link-rule { align-self: flex-start; }
  .mapwrap { grid-column: 8 / span 5; }
  @media (max-width: 900px) { .copy { grid-column: span 12; } .mapwrap { grid-column: span 12; max-width: 520px; } }
</style>
