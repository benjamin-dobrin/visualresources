---
/**
 * A photograph, or a clearly marked placeholder until one is supplied.
 * Pass `src` (an imported image or a collection image field) to render the real thing.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  label?: string;
  tone?: 'warm' | 'stone' | 'night' | 'light' | 'slate' | 'brown' | 'sand' | 'steel';
  sizes?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}
const { src, alt = '', label = 'Photo', tone = 'stone', sizes = '(max-width: 900px) 100vw, 50vw', class: cls = '', loading = 'lazy' } = Astro.props;
const light = tone === 'light' || tone === 'sand';
---
<div class:list={['photo', cls, { placeholder: !src, light: !src && light }]} data-tone={src ? undefined : tone}>
  {src ? (
    <Image src={src} alt={alt} widths={[480, 960, 1440, 2000]} sizes={sizes} loading={loading} />
  ) : (
    <span class="cap mono">{label}</span>
  )}
</div>

<style>
  .photo { position: relative; overflow: hidden; background: var(--stock); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cap { position: absolute; left: 16px; bottom: 14px; font-size: 11px; letter-spacing: 0.04em; color: rgba(246, 242, 234, 0.75); line-height: 1.5; max-width: 70%; }
  .light .cap { color: rgba(32, 28, 27, 0.7); }
  .placeholder[data-tone="warm"] { background: linear-gradient(170deg, #8a6a55 0%, #4a342b 45%, #1e1a19 100%); }
  .placeholder[data-tone="stone"] { background: linear-gradient(170deg, #a8a297 0%, #6e685f 50%, #35312d 100%); }
  .placeholder[data-tone="night"] { background: linear-gradient(160deg, #3d3a44 0%, #23212a 60%, #141317 100%); }
  .placeholder[data-tone="light"] { background: linear-gradient(160deg, #efe7d9 0%, #d6cbb8 55%, #ab9f8d 100%); }
  .placeholder[data-tone="slate"] { background: linear-gradient(170deg, #6f7c86 0%, #3f4850 55%, #22272c 100%); }
  .placeholder[data-tone="brown"] { background: linear-gradient(160deg, #7b5e3e 0%, #4a3826 55%, #241c14 100%); }
  .placeholder[data-tone="sand"] { background: linear-gradient(160deg, #e6dfd3 0%, #c8bfae 55%, #958b7b 100%); }
  .placeholder[data-tone="steel"] { background: linear-gradient(160deg, #56616b 0%, #2f373f 60%, #191d21 100%); }
</style>
