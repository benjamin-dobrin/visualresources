---
/**
 * Client proof. Logos when files exist in public/logos, names in the serif until then.
 * Logo files are served as-is (no optimisation needed for SVG) and given equal optical
 * weight so the row reads as one object. Deliberately static: a moving strip reads as a
 * short list being padded, and the map pin is the only motion this design should carry.
 */
import { site, url } from '../lib/site';

const names = site.client_names as string[];
const logos = (site.client_logos ?? []) as { name: string; src: string; mark?: boolean }[];
const treatment = (site.logo_treatment ?? 'ink') as 'ink' | 'colour';
---
<section class="trust wrap" aria-label="Clients">
  <span class="k">Trusted by</span>
  {logos.length ? (
    <ul class:list={['logos', treatment]}>
      {logos.map((l) => (
        <li><img src={url(l.src)} alt={l.name} loading="lazy" data-mark={l.mark ? "" : undefined} /></li>
      ))}
    </ul>
  ) : (
    <ul class="names">{names.map((n) => <li class="serif">{n}</li>)}</ul>
  )}
</section>

<style>
  .trust { display: flex; align-items: center; gap: 40px; padding-top: 22px; padding-bottom: 22px; border-bottom: 1px solid var(--rule); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 12px 36px; flex: 1; flex-wrap: wrap; }

  /* Equal-height boxes so no single client's file dictates the row's scale. */
  .logos li { display: flex; align-items: center; justify-content: center; height: 40px; }
  .logos img { max-height: 29px; max-width: 136px; width: auto; object-fit: contain; }
  /* A square mark needs more height than a wordmark to read at the same weight. */
  .logos img[data-mark] { max-height: 40px; }
  .logos.ink img { filter: grayscale(1) brightness(0); opacity: 0.66; }
  .logos.colour img { opacity: 0.95; }

  .names li { font-size: 18px; line-height: 1; color: var(--body); white-space: nowrap; }
  @media (max-width: 900px) {
    .trust { flex-direction: column; align-items: flex-start; gap: 14px; }
    ul { gap: 10px 28px; }
    .names li { font-size: 17px; }
    .logos li { height: 34px; }
    .logos img { max-height: 25px; max-width: 112px; }
    .logos img[data-mark] { max-height: 34px; }
  }
</style>
