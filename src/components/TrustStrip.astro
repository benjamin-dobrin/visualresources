---
/**
 * Client proof. Logos when files exist, names in the serif until then.
 * Logos are forced to a single ink colour and given equal optical weight so the row
 * reads as one object rather than a rainbow of competing brand colours. Deliberately
 * static: a moving strip reads as padding a short list, and this design has no other
 * motion to keep it company.
 */
import { site } from '../lib/site';
import { resolveMedia } from '../lib/media';

const names = site.client_names as string[];
const logos = await Promise.all(
  (site.client_logos as { name: string; src: string }[]).map(async (l) => ({
    name: l.name,
    img: l.src?.endsWith('.svg') ? undefined : await resolveMedia(l.src),
    raw: l.src,
  })),
);
const hasLogos = logos.some((l) => l.img || l.raw);
---
<section class="trust wrap" aria-label="Clients">
  <span class="k">Trusted by</span>
  {hasLogos ? (
    <ul class="logos">
      {logos.map((l) => (
        <li><img src={l.img?.src ?? l.raw} alt={l.name} loading="lazy" /></li>
      ))}
    </ul>
  ) : (
    <ul class="names">{names.map((n) => <li class="serif">{n}</li>)}</ul>
  )}
</section>

<style>
  .trust { display: flex; align-items: center; gap: 40px; padding-top: 22px; padding-bottom: 22px; border-bottom: 1px solid var(--rule); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 12px 36px; flex: 1; flex-wrap: wrap; }

  /* Every logo sits in a box of the same height and is knocked back to ink, whatever
     colour the file is, so no single client shouts over the others. */
  .logos li { display: flex; align-items: center; justify-content: center; height: 30px; }
  .logos img {
    max-height: 30px;
    max-width: 132px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1) brightness(0);
    opacity: 0.68;
  }

  .names li { font-size: 18px; line-height: 1; color: var(--body); white-space: nowrap; }
  @media (max-width: 900px) {
    .trust { flex-direction: column; align-items: flex-start; gap: 14px; }
    ul { gap: 10px 28px; }
    .names li { font-size: 17px; }
    .logos li { height: 26px; }
    .logos img { max-height: 26px; max-width: 108px; }
  }
</style>
