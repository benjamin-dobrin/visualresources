---
import CropMarks from './CropMarks.astro';
import { site } from '../lib/site';
interface Props { heading?: string; eyebrow?: string; page?: boolean }
const { heading = 'Send what you have. Rough is fine.', eyebrow = 'Start a project', page = false } = Astro.props;
const jobs = [
  'Open or refresh a location',
  'Roll out to multiple locations',
  'Trade show or event',
  'Campaign, retail or OOH graphics',
  'Brand an interior',
  'Construction site or barricade',
  'Film, TV or photo set',
  'Agency production partner',
  'Not sure yet — need guidance',
];
---
<section class:list={['start', 'wrap', { page }]} id="start">
  <CropMarks color="rgba(246,242,234,0.75)" inset="24px" />
  <div class="copy">
    <p class="k">{eyebrow}</p>
    {page ? <h1 class="display">{heading}</h1> : <h2 class="display">{heading}</h2>}
    <p class="lede">A file, a photo of the wall, a deadline. A producer replies within one business day with next steps and a ballpark.</p>
    <div class="talk" id="talk">
      {site.booking_url ? <a class="book" href={site.booking_url}>Book 15 minutes with a producer</a> : <span class="book">Book 15 minutes with a producer</span>}
      <span class="mono">{site.phones.map((p) => p.display).join(' · ')}</span>
      <a class="mono" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
  <form class="form" id="intake" method="post" action={site.form_endpoint} novalidate>
    <label>Your name <span class="req">*</span><input name="name" type="text" required autocomplete="name" /></label>
    <label>Company<input name="business" type="text" autocomplete="organization" /></label>
    <label>Email <span class="req">*</span><input name="email" type="email" required autocomplete="email" /></label>
    <label>Phone<input name="phone" type="tel" autocomplete="tel" /></label>
    <label>What are you working on? <span class="req">*</span>
      <select name="type" required><option value="">Select one…</option>{jobs.map((j) => <option>{j}</option>)}</select>
    </label>
    <label>Where<input name="location" type="text" placeholder="City / site — nationwide OK" /></label>
    <label>Deadline
      <select name="timeline"><option value="">Select one…</option><option>ASAP / rush</option><option>Within a month</option><option>1–3 months</option><option>Just exploring</option></select>
    </label>
    <label>Budget range (optional)
      <select name="budget"><option value="">Select one…</option><option>Under $1,000</option><option>$1,000 – $5,000</option><option>$5,000 – $15,000</option><option>$15,000 – $50,000</option><option>$50,000+</option><option>Not sure</option></select>
    </label>
    <label class="wide">Details <span class="req">*</span><textarea name="details" required rows="4"></textarea></label>
    <label class="wide">Files<input name="files" type="url" placeholder="Paste a Drive, Dropbox or WeTransfer link" /></label>
    <button class="btn btn-ink wide" type="submit">Send to a producer</button>
    <p class="msg ok" role="status" hidden>Received. A producer will be in touch within one business day.</p>
    <p class="msg err" role="alert" hidden>Something went wrong. Please email <a href={`mailto:${site.email}`}>{site.email}</a> instead.</p>
  </form>
</section>

<style>
  .start { position: relative; background: var(--red); color: var(--paper); padding-top: var(--section); padding-bottom: var(--section); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 32px; align-items: start; }
  .copy { grid-column: span 5; display: flex; flex-direction: column; gap: 20px; }
  .copy .k { color: rgba(246, 242, 234, 0.8); }
  .copy h1, .copy h2 { font-size: clamp(34px, 3.6vw, 52px); line-height: 1.06; letter-spacing: -0.01em; color: var(--paper); }
  .copy .lede { color: rgba(246, 242, 234, 0.9); max-width: 28em; }
  .talk { display: flex; flex-direction: column; gap: 8px; margin-top: 6px; font-size: 15px; font-weight: 500; }
  .talk .mono { font-size: 13px; color: rgba(246, 242, 234, 0.85); font-weight: 400; }
  .talk a:hover { color: #fff; }
  .book { color: var(--paper); border-bottom: 1px solid var(--paper); align-self: flex-start; padding-bottom: 2px; }
  .form { grid-column: 7 / span 6; background: var(--paper); color: var(--ink); padding: 28px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 24px; }
  label { display: flex; flex-direction: column; gap: 6px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .req { color: var(--red); }
  input, select, textarea { font: 16px/1.4 var(--sans); color: var(--ink); background: transparent; border: 0; border-bottom: 1px solid var(--ink); padding: 10px 0; width: 100%; border-radius: 0; }
  input:focus, select:focus, textarea:focus { outline: none; border-bottom-color: var(--red); }
  textarea { resize: vertical; }
  .wide { grid-column: span 2; }
  .form .btn { margin-top: 8px; text-align: center; border: 0; cursor: pointer; font-family: var(--sans); }
  .msg { grid-column: span 2; font-size: 15px; font-weight: 500; padding: 14px 16px; border: 1px solid var(--ink); }
  .msg.err { border-color: var(--red); color: var(--red); }
  @media (max-width: 900px) { .copy, .form { grid-column: span 12; } }
  @media (max-width: 560px) { .form { grid-template-columns: 1fr; padding: 22px; } .wide, .msg { grid-column: span 1; } }
</style>

<script>
  const form = document.getElementById('intake') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const ok = form.querySelector<HTMLElement>('.msg.ok')!;
    const err = form.querySelector<HTMLElement>('.msg.err')!;
    btn.disabled = true; btn.textContent = 'Sending…';
    try {
      await fetch(form.action, { method: 'POST', body: new FormData(form) });
      err.hidden = true; ok.hidden = false; form.reset();
      ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      err.hidden = false;
    } finally {
      btn.disabled = false; btn.textContent = 'Send to a producer';
    }
  });
</script>
